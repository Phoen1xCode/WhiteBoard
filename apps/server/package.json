{
  "name": "@whiteboard/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "test": "vitest run --config src/tests/vitest.config.ts",
    "test:watch": "vitest --config src/tests/vitest.config.ts",
