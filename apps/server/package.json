    "@prisma/client": "^7.9.1",
    "@scalar/hono-api-reference": "^0.9.48",
    "@whiteboard/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.26",
    "dotenv": "^17.4.2",
    "hono": "^4.13.0",
    "hono-pino": "^0.10.3",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
